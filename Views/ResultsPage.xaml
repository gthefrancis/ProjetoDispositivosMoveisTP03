<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RastreioEncomendas.Views.ResultsPage"
             BackgroundColor="{StaticResource PageBackground}"
             Title="Resultado do rastreamento">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="18,48,18,14" ColumnDefinitions="Auto,*">
            <Button Text="‹" FontSize="30" WidthRequest="48" HeightRequest="44"
                    Padding="0" BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="Detalhes da encomenda"
                   FontSize="20" FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{StaticResource TextPrimary}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,8,18,28" Spacing="14">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}" />
                <Label Text="{Binding ErrorMessage}" TextColor="#C62828"
                       IsVisible="{Binding HasError}" FontSize="15" />

                <Border BackgroundColor="White" Stroke="#E5E9F0" StrokeThickness="1"
                        Padding="18" StrokeShape="RoundRectangle 16"
                        IsVisible="{Binding HasPackage}">
                    <VerticalStackLayout Spacing="9">
                        <Label Text="CÓDIGO DE RASTREAMENTO" FontSize="11"
                               CharacterSpacing="1.2"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding Package.PackageId}" FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Border BackgroundColor="#E8F1FF" StrokeThickness="0"
                                Padding="10,6" HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 10">
                            <Label Text="{Binding Package.Status}" TextColor="#2457C5"
                                   FontAttributes="Bold" FontSize="13" />
                        </Border>
                        <BoxView HeightRequest="1" Color="#EDF0F5" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Data de envio" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding Package.ShippingDateLabel}"
                                       FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Previsão de entrega" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding Package.EstimatedDeliveryDateLabel}"
                                       FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#EDF0F5" />
                        <Label Text="Localização atual" FontSize="12"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding Package.CurrentLocation}"
                               FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Histórico de movimentações" FontSize="18"
                       FontAttributes="Bold" Margin="2,8,0,0"
                       TextColor="{StaticResource TextPrimary}"
                       IsVisible="{Binding HasPackage}" />

                <CollectionView ItemsSource="{Binding Events}"
                                IsVisible="{Binding HasPackage}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="20,*" ColumnSpacing="12"
                                  Padding="2,8,2,12">
                                <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                    <BoxView Color="#2457C5" WidthRequest="10"
                                             HeightRequest="10" CornerRadius="5" />
                                    <BoxView Color="#D7E1F2" WidthRequest="2"
                                             VerticalOptions="FillAndExpand" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="{Binding Description}"
                                           FontAttributes="Bold" FontSize="14"
                                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding Location}" FontSize="13"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding DateLabel}" FontSize="12"
                                           TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
